# A variável REDIS_URL é criada automaticamente pela Vercel quando você
# conecta um banco Redis (Storage -> Create Database -> Redis) ao projeto —
# não precisa configurá-la manualmente.
#
# Para rodar localmente com `vercel dev`, puxe as variáveis do projeto com:
#   vercel env pull .env.local
#
# A antiga APP_PASSWORD não é mais usada: agora cada pessoa entra com o
# próprio usuário e senha, cadastrados pela tela de login do site.
REDIS_URL=

# BLOB_READ_WRITE_TOKEN é criada automaticamente ao conectar um Blob store
# (Storage -> Create Database -> Blob). Guarda os anexos dos simulados.
BLOB_READ_WRITE_TOKEN=

# Opcional: só use "public" se o seu Blob store tiver sido criado como público.
# BLOB_ACCESS=public
